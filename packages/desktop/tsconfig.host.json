{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/host",
    "rootDir": "src/host",
    "lib": ["es2025"]
  },
  "include": ["src/host"],
  // host 既直接依赖 services/shared，也直接 import 了 rpc；补 references 是为了避免它再次把 rpc 源码拉进来检查。
  // Personal 远端入口直接引用 server，必须复用该工程的声明产物。
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../rpc" },
    { "path": "../server" }
  ]
}
